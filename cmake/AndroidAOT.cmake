# Extract target enum types without running a target executable on the host.
function(dassdl3_android_enum_profile output)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(snapshot "${root}/src/generated/linux/sdl3_types.inc")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snapshot}")
    file(STRINGS "${snapshot}" enumLines REGEX "^DAS_BIND_ENUM_CAST\\(")
    set(enumNames "")
    foreach(line IN LISTS enumLines)
        string(REGEX MATCH "SDL_[a-zA-Z0-9_]+" name "${line}")
        string(APPEND enumNames "PROFILE(sdl3, ${name})\n")
    endforeach()
    add_library(android_enum_profile OBJECT "${root}/android/enum_profile.cpp")
    target_include_directories(android_enum_profile PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    target_compile_features(android_enum_profile PRIVATE cxx_std_17)
    target_link_libraries(android_enum_profile PRIVATE SDL3::Headers)
    foreach(feature TTF NET SOUND)
        if(DASSDL3_WITH_${feature})
            string(TOLOWER "${feature}" library)
            set(snapshot "${root}/src/libraries/generated/${library}_types.inc")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snapshot}")
            file(STRINGS "${snapshot}" enumLines REGEX "^class Enum_")
            foreach(line IN LISTS enumLines)
                string(REGEX MATCH "^class Enum_([a-zA-Z0-9_]+)" ignored "${line}")
                string(APPEND enumNames "PROFILE(sdl3_${library}, ${CMAKE_MATCH_1})\n")
            endforeach()
            target_compile_definitions(android_enum_profile PRIVATE DASSDL3_WITH_${feature})
            target_link_libraries(android_enum_profile PRIVATE dasSDL3_${library})
        endif()
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/android_enum_names.inc" CONTENT "${enumNames}")
    set(profile "${CMAKE_CURRENT_BINARY_DIR}/android-enums.txt")
    add_custom_command(OUTPUT "${profile}"
        COMMAND "${CMAKE_OBJCOPY}" --dump-section ".dassdl3.enums=${profile}"
            "$<TARGET_OBJECTS:android_enum_profile>" "${CMAKE_CURRENT_BINARY_DIR}/android-enums.o"
        DEPENDS android_enum_profile $<TARGET_OBJECTS:android_enum_profile> VERBATIM)
    set(${output} "${profile}" PARENT_SCOPE)
endfunction()
