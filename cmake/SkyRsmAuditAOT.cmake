# Focused strict AOT target using the current production snapshots (no Clang generator).
option(DASSDL3_SKY_RSM_AUDIT "Build strict AOT checks for sky/rsm audit and benchmarks" OFF)
if(NOT DASSDL3_SKY_RSM_AUDIT OR NOT WIN32)
    return()
endif()
target_compile_definitions(dasSDL3 PRIVATE DASSDL3_AOT_HEADER="sdl3_aot.h")
add_executable(sky_rsm_aot_tool "${PROJECT_SOURCE_DIR}/tests/clangbind_parity/aot_tool.cpp")
add_executable(sky_rsm_aot_runner "${PROJECT_SOURCE_DIR}/tests/clangbind_parity/aot_runner.cpp")
foreach(target sky_rsm_aot_tool sky_rsm_aot_runner)
    target_link_libraries(${target} PRIVATE dasSDL3)
    target_compile_definitions(${target} PRIVATE DASSDL3_DAS_ROOT="${PROJECT_SOURCE_DIR}/third_party/daScript" DASSDL3_MODULE_ROOT="${PROJECT_SOURCE_DIR}/dassdl3")
    target_compile_options(${target} PRIVATE /bigobj)
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    if(DASSDL3_WITH_SHADERCROSS)
        target_link_libraries(${target} PRIVATE dasSDL3_shadercross)
        target_compile_definitions(${target} PRIVATE DASSDL3_WITH_SHADERCROSS=1)
        dassdl3_shadercross_runtime(${target})
    endif()
endforeach()

if(BUILD_TESTING)
    foreach(driver vulkan direct3d12)
        if(driver STREQUAL "direct3d12" AND NOT DASSDL3_WITH_SHADERCROSS)
            continue()
        endif()
        foreach(case sky rsm)
            foreach(kind interpreter aot)
                set(runner dasSDL3_runner)
                if(driver STREQUAL "direct3d12")
                    set(runner dasSDL3_libraries_runner)
                endif()
                set(args --smoke-test)
                if(kind STREQUAL "aot")
                    set(runner sky_rsm_aot_runner)
                    set(args)
                endif()
                add_test(NAME sky_rsm_audit_${case}_${kind}_${driver} COMMAND ${runner} "${PROJECT_SOURCE_DIR}/tests/bgfx_${case}.das" ${args})
                set_tests_properties(sky_rsm_audit_${case}_${kind}_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
                    ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}"
                    FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
            endforeach()
            if(DASSDL3_WITH_IMGUI)
                if(case STREQUAL "sky")
                    set(example example_27_sky)
                else()
                    set(example example_22_rsm)
                endif()
                add_test(NAME sky_rsm_audit_${case}_gui_${driver} COMMAND dasSDL3_libraries_runner
                    "${PROJECT_SOURCE_DIR}/examples/gpu_port_bgfx/${example}/main.das" --smoke-test)
                set_tests_properties(sky_rsm_audit_${case}_gui_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
                    ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}"
                    PASS_REGULAR_EXPRESSION "ImGui panel: 3 frames rendered"
                    FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
            endif()
        endforeach()
    endforeach()
endif()
set(audit_common)
foreach(name shader_support bgfx_support mesh_data port_geometry multipass_support compute_support)
 list(APPEND audit_common "${PROJECT_SOURCE_DIR}/examples/gpu_port_bgfx/common/${name}.das")
endforeach()
file(GLOB_RECURSE audit_sky "${PROJECT_SOURCE_DIR}/examples/gpu_port_bgfx/example_27_sky/*.das")
file(GLOB_RECURSE audit_rsm "${PROJECT_SOURCE_DIR}/examples/gpu_port_bgfx/example_22_rsm/*.das")
set(scripts ${audit_common} ${audit_sky} ${audit_rsm})
list(FILTER scripts EXCLUDE REGEX "(_gui|/main)\\.das$")
foreach(name benchmark_gpu_sky benchmark_gpu_rsm bgfx_sky bgfx_rsm bgfx_capture bgfx_multipass_checks bgfx_buffer_checks sky_rsm_audit)
 list(APPEND scripts "${PROJECT_SOURCE_DIR}/tests/${name}.das")
endforeach()
foreach(name sdl3_window_boost sdl3_result sdl3_boost sdl3_gpu_result sdl3_gpu_boost sdl3_gpu_shader_boost sdl3_gpu_native_boost sdl3_gpu_pipeline_boost sdl3_gpu_sampler_boost sdl3_pixels_boost sdl3_iostream_boost sdl3_events sdl3_init_boost sdl3_shader_resources sdl3_shader_dsl sdl3_shader_compute sdl3_shader_storage sdl3_shader_storage_spirv sdl3_shader_uniforms)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/dassdl3/${name}.das")
endforeach()
list(APPEND scripts "${PROJECT_SOURCE_DIR}/examples/gpu_dsl/backend_support.das")
foreach(name spirv_reflect spirv_dis spirv_builder spirv_grammar)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/third_party/daScript/modules/dasSpirv/spirv/${name}.das")
endforeach()
foreach(name math_boost math_bits shader_lingua_franca)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/third_party/daScript/daslib/${name}.das")
endforeach()
if(DASSDL3_WITH_SHADERCROSS)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/dassdl3/sdl3_shader_dsl_cross.das" "${PROJECT_SOURCE_DIR}/dassdl3/sdl3_shadercross_boost.das")
endif()
set(audit_dependencies ${scripts})
foreach(script IN LISTS scripts)
    string(SHA256 key "${script}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/sky_rsm_${key}.aot.cpp")
    add_custom_command(OUTPUT "${output}" COMMAND sky_rsm_aot_tool "${script}" "${output}.tmp"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}"
        DEPENDS sky_rsm_aot_tool "${script}" ${audit_dependencies} VERBATIM)
    target_sources(sky_rsm_aot_runner PRIVATE "${output}")
endforeach()
