# Focused strict AOT target using the current production snapshots (no Clang generator).
option(DASSDL3_FORGE_AOT "Build strict AOT checks for forge-gpu examples" OFF)
if(NOT DASSDL3_FORGE_AOT OR NOT WIN32)
    return()
endif()
target_compile_definitions(dasSDL3 PRIVATE DASSDL3_AOT_HEADER="sdl3_aot.h")
add_executable(forge_aot_tool "${PROJECT_SOURCE_DIR}/tests/clangbind_parity/aot_tool.cpp")
target_compile_definitions(forge_aot_tool PRIVATE DASSDL3_AOT_STANDALONE_JSON_RTTI=1)
add_executable(forge_aot_runner "${PROJECT_SOURCE_DIR}/tests/clangbind_parity/aot_runner.cpp")
foreach(target forge_aot_tool forge_aot_runner)
    target_link_libraries(${target} PRIVATE dasSDL3)
    target_compile_definitions(${target} PRIVATE DASSDL3_DAS_ROOT="${PROJECT_SOURCE_DIR}/third_party/daScript" DASSDL3_MODULE_ROOT="${PROJECT_SOURCE_DIR}/dassdl3")
    target_compile_options(${target} PRIVATE /bigobj)
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    if(DASSDL3_WITH_SHADERCROSS)
        target_link_libraries(${target} PRIVATE dasSDL3_shadercross)
        target_compile_definitions(${target} PRIVATE DASSDL3_WITH_SHADERCROSS=1)
        dassdl3_shadercross_runtime(${target})
    endif()
endforeach()
file(GLOB_RECURSE forge_scripts CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/examples/gpu_port_forge/*.das")
file(GLOB forge_dependencies CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dassdl3/*.das")
list(APPEND forge_dependencies ${forge_scripts} "${PROJECT_SOURCE_DIR}/tests/forge_pixels.das" "${PROJECT_SOURCE_DIR}/tests/forge_color.das" "${PROJECT_SOURCE_DIR}/tests/forge_advanced_pixels.das" "${PROJECT_SOURCE_DIR}/tests/forge_extended_contracts.das")
set(scripts ${forge_scripts} "${PROJECT_SOURCE_DIR}/tests/forge_pixels.das" "${PROJECT_SOURCE_DIR}/tests/forge_color.das" "${PROJECT_SOURCE_DIR}/tests/forge_advanced_pixels.das" "${PROJECT_SOURCE_DIR}/tests/forge_extended_contracts.das")
foreach(name sdl3_result sdl3_boost sdl3_gpu_result sdl3_gpu_boost sdl3_gpu_shader_boost sdl3_gpu_native_boost sdl3_gpu_pipeline_boost sdl3_gpu_sampler_boost sdl3_pixels_boost sdl3_iostream_boost sdl3_events sdl3_init_boost sdl3_shader_resources sdl3_shader_dsl sdl3_shader_compute sdl3_shader_storage sdl3_shader_storage_spirv sdl3_shader_uniforms)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/dassdl3/${name}.das")
endforeach()
list(APPEND scripts "${PROJECT_SOURCE_DIR}/examples/gpu_dsl/backend_support.das")
foreach(name spirv_reflect spirv_dis spirv_builder spirv_grammar spirv_builtins)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/third_party/daScript/modules/dasSpirv/spirv/${name}.das")
endforeach()
foreach(name math_boost math_bits shader_lingua_franca json json_boost)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/third_party/daScript/daslib/${name}.das")
endforeach()
if(DASSDL3_WITH_SHADERCROSS)
    list(APPEND scripts "${PROJECT_SOURCE_DIR}/dassdl3/sdl3_shader_dsl_cross.das" "${PROJECT_SOURCE_DIR}/dassdl3/sdl3_shadercross_boost.das")
endif()
foreach(script IN LISTS scripts)
    string(SHA256 key "${script}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/forge_${key}.aot.cpp")
    add_custom_command(OUTPUT "${output}" COMMAND forge_aot_tool "${script}" "${output}.tmp"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}"
        DEPENDS forge_aot_tool "${script}" ${forge_dependencies} VERBATIM)
    target_sources(forge_aot_runner PRIVATE "${output}")
endforeach()
if(BUILD_TESTING)
    foreach(driver vulkan direct3d12)
        if(driver STREQUAL "direct3d12" AND NOT DASSDL3_WITH_SHADERCROSS)
            continue()
        endif()
        add_test(NAME forge_aot_extended_contracts_${driver} COMMAND forge_aot_runner "${PROJECT_SOURCE_DIR}/tests/forge_extended_contracts.das")
        set_tests_properties(forge_aot_extended_contracts_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
        if(Python3_EXECUTABLE)
            add_test(NAME forge_aot_extended_pixels_${driver} COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/test_forge_extended.py" --runner $<TARGET_FILE:forge_aot_runner> --driver ${driver} --aot --variants)
            set_tests_properties(forge_aot_extended_pixels_${driver} PROPERTIES TIMEOUT 900 RUN_SERIAL TRUE ENVIRONMENT "VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
            set(_forge_advanced_reference)
            if(DASSDL3_FORGE_REFERENCE_BIN)
                list(APPEND _forge_advanced_reference --original-bin "${DASSDL3_FORGE_REFERENCE_BIN}")
            endif()
            add_test(NAME forge_aot_advanced_pixels_${driver} COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/test_forge_advanced.py"
                --runner $<TARGET_FILE:forge_aot_runner> --driver ${driver} --aot ${_forge_advanced_reference})
            set_tests_properties(forge_aot_advanced_pixels_${driver} PROPERTIES TIMEOUT 240 RUN_SERIAL TRUE
                ENVIRONMENT "VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
        endif()
        add_test(NAME forge_aot_color_${driver} COMMAND forge_aot_runner "${PROJECT_SOURCE_DIR}/tests/forge_color.das")
        set_tests_properties(forge_aot_color_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
            ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}"
            FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
        if(DASSDL3_FORGE_REFERENCE_BIN AND Python3_EXECUTABLE)
            add_test(NAME forge_aot_reference_${driver} COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/test_forge_color_reference.py"
                --original-bin "${DASSDL3_FORGE_REFERENCE_BIN}" --runner $<TARGET_FILE:forge_aot_runner> --driver ${driver} --aot)
            set_tests_properties(forge_aot_reference_${driver} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE
                ENVIRONMENT "VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
        endif()
        foreach(lesson IN LISTS _forge_lessons)
            add_test(NAME forge_aot_${lesson}_${driver} COMMAND forge_aot_runner "${PROJECT_SOURCE_DIR}/examples/gpu_port_forge/example_${lesson}/main.das")
            set_tests_properties(forge_aot_${lesson}_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
                ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}"
                FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
        endforeach()
        add_test(NAME forge_aot_pixels_${driver} COMMAND forge_aot_runner "${PROJECT_SOURCE_DIR}/tests/forge_pixels.das")
        set_tests_properties(forge_aot_pixels_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
            ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort;VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}"
            FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
    endforeach()
endif()
