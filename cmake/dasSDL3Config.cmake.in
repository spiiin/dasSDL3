@PACKAGE_INIT@
if("@DASSDL3_SDK_PLATFORM@" STREQUAL "macos")
    if(NOT APPLE OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "This SDK contains macOS @DASSDL3_SDK_ARCH@ AppleClang binaries")
    endif()
    set(_dassdl3_consumer_arch "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_OSX_ARCHITECTURES)
        set(_dassdl3_consumer_arch "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    if(NOT _dassdl3_consumer_arch STREQUAL "@DASSDL3_SDK_ARCH@")
        message(FATAL_ERROR "This SDK requires architecture @DASSDL3_SDK_ARCH@")
    endif()
elseif(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8
   OR NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
    message(FATAL_ERROR "This SDK contains Windows x64 MSVC binaries")
endif()
if(NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "This SDK requires single-config Release")
endif()
if(WIN32 AND DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "This SDK requires CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/dasSDL3SDKTargets.cmake")
set_and_check(dasSDL3_DATA_DIR "${PACKAGE_PREFIX_DIR}/share/dasSDL3")
include("${CMAKE_CURRENT_LIST_DIR}/dasSDL3AOT.cmake")
check_required_components(dasSDL3)
