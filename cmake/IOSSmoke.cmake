    endif()
    if(NOT DASSDL3_WITH_TTF)
        foreach(_asset JetBrainsMono-Regular.ttf OFL.txt AUTHORS.txt)
            _iphone_resource("${_root}/examples/libraries/assets/${_asset}" assets/libraries)
        endforeach()
    endif()
endif()
