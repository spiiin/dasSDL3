options gen2
require sdl3
[export]
def main(smoke : bool) : int {
    let depth = SDL_GPUDepthStencilTargetInfo(mip_level = uint8(2), layer = uint8(3))
    let multisample = SDL_GPUMultisampleState(enable_alpha_to_coverage = true)
    let pen = SDL_PenProximityEvent(pen_state = 7u)
    verify(depth.mip_level == uint8(2) && depth.layer == uint8(3))
    verify(multisample.enable_alpha_to_coverage && pen.pen_state == 7u)
    verify(SDL_HINT_ALLOW_ALT_TAB_WHILE_GRABBED == "SDL_ALLOW_ALT_TAB_WHILE_GRABBED")
