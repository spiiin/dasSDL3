# Independent programs following the twenty published SDL3 tutorial topics.
option(DASSDL3_LAZYFOO_AOT "Build strict AOT checks for the SDL3 tutorial topic examples" OFF)
if(NOT DASSDL3_WITH_IMAGE OR NOT DASSDL3_WITH_TTF OR NOT DASSDL3_WITH_MIXER)
    if(DASSDL3_LAZYFOO_AOT)
        message(FATAL_ERROR "Lazy Foo topic AOT examples require DASSDL3_WITH_IMAGE, DASSDL3_WITH_TTF and DASSDL3_WITH_MIXER")
    endif()
    return()
endif()
file(GLOB _lazyfoo_assets CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/examples/sdl_port_lazyfoo/assets/*")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/bin/assets/lazyfoo")
foreach(asset IN LISTS _lazyfoo_assets)
    get_filename_component(name "${asset}" NAME)
    configure_file("${asset}" "${CMAKE_BINARY_DIR}/bin/assets/lazyfoo/${name}" COPYONLY)
endforeach()
if(BUILD_TESTING AND Python3_EXECUTABLE)
    add_test(NAME lazyfoo_examples COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_lazyfoo_examples.py"
        --runner $<TARGET_FILE:dasSDL3_libraries_runner> --output "${CMAKE_BINARY_DIR}/lazyfoo-interpreter")
    set_tests_properties(lazyfoo_examples PROPERTIES TIMEOUT 300 RUN_SERIAL TRUE)
endif()
include("${CMAKE_SOURCE_DIR}/cmake/LazyfooExamplesAOT.cmake")
