set(DASSDL3_FORGE_REFERENCE_BIN "" CACHE PATH "Optional unchanged forge original_10/14-20 capture executables")
# forge-gpu 10-52: all assets are checked in; no network or shader tools at runtime.
file(GLOB_RECURSE _forge_assets CONFIGURE_DEPENDS RELATIVE "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/assets" "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/assets/*")
foreach(name IN LISTS _forge_assets)
    get_filename_component(parent "${CMAKE_BINARY_DIR}/bin/assets/forge/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    configure_file("${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/assets/${name}" "${CMAKE_BINARY_DIR}/bin/assets/forge/${name}" COPYONLY)
endforeach()
file(GLOB _forge_entries CONFIGURE_DEPENDS RELATIVE "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge" "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/example_*/main.das")
set(_forge_lessons)
foreach(entry IN LISTS _forge_entries)
    string(REGEX REPLACE "^example_(.*)/main.das$" "\\1" lesson "${entry}")
    list(APPEND _forge_lessons "${lesson}")
endforeach()
if(BUILD_TESTING AND WIN32)
    foreach(driver vulkan direct3d12)
        if(driver STREQUAL "direct3d12" AND NOT DASSDL3_WITH_SHADERCROSS)
            continue()
        endif()
        set(runner dasSDL3_runner)
        if(driver STREQUAL "direct3d12")
            set(runner dasSDL3_libraries_runner)
        endif()
        add_test(NAME forge_extended_contracts_${driver} COMMAND ${runner} "${CMAKE_SOURCE_DIR}/tests/forge_extended_contracts.das" --smoke-test)
        set_tests_properties(forge_extended_contracts_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort")
        if(Python3_EXECUTABLE)
            add_test(NAME forge_extended_pixels_${driver} COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_forge_extended.py" --runner $<TARGET_FILE:${runner}> --driver ${driver} --variants)
            set_tests_properties(forge_extended_pixels_${driver} PROPERTIES TIMEOUT 900 RUN_SERIAL TRUE)
            set(_forge_advanced_reference)
            if(DASSDL3_FORGE_REFERENCE_BIN)
                list(APPEND _forge_advanced_reference --original-bin "${DASSDL3_FORGE_REFERENCE_BIN}")
            endif()
            add_test(NAME forge_advanced_pixels_${driver} COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_forge_advanced.py"
                --runner $<TARGET_FILE:${runner}> --driver ${driver} ${_forge_advanced_reference})
            set_tests_properties(forge_advanced_pixels_${driver} PROPERTIES TIMEOUT 240 RUN_SERIAL TRUE)
        endif()
        add_test(NAME forge_color_${driver} COMMAND ${runner} "${CMAKE_SOURCE_DIR}/tests/forge_color.das" --smoke-test)
        set_tests_properties(forge_color_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
            ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort"
            FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
        if(DASSDL3_FORGE_REFERENCE_BIN AND Python3_EXECUTABLE)
            add_test(NAME forge_reference_${driver} COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_forge_color_reference.py"
                --original-bin "${DASSDL3_FORGE_REFERENCE_BIN}" --runner $<TARGET_FILE:${runner}> --driver ${driver})
            set_tests_properties(forge_reference_${driver} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
        endif()
        foreach(lesson IN LISTS _forge_lessons)
            add_test(NAME forge_${lesson}_${driver} COMMAND ${runner}
                "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/example_${lesson}/main.das" --smoke-test)
            set_tests_properties(forge_${lesson}_${driver} PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE
                ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort"
                FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
        endforeach()
        if(Python3_EXECUTABLE)
            add_test(NAME forge_pixels_${driver} COMMAND "${Python3_EXECUTABLE}"
                "${CMAKE_SOURCE_DIR}/tests/test_forge_examples.py" --runner $<TARGET_FILE:${runner}> --driver ${driver})
            set_tests_properties(forge_pixels_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE)
        endif()
    endforeach()
    if(Python3_EXECUTABLE)
        add_test(NAME forge_asset_hashes COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_forge_assets.py")
        set_tests_properties(forge_asset_hashes PROPERTIES TIMEOUT 60)
        add_test(NAME forge_shader_compiler COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_SOURCE_DIR}/tests/test_forge_shaders.py" --runner $<TARGET_FILE:dasSDL3_runner> ${_dsl_validator})
        set_tests_properties(forge_shader_compiler PROPERTIES TIMEOUT 240)
    endif()
    if(DASSDL3_TEST_VULKAN_LAYERS_DISABLE)
        get_property(_forge_tests DIRECTORY PROPERTY TESTS)
        foreach(test IN LISTS _forge_tests)
            if(test MATCHES "^forge_")
                set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
            endif()
        endforeach()
    endif()
endif()
