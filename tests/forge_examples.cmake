# forge-gpu 10-14: all assets are checked in; no network or shader tools at runtime.
file(GLOB _forge_assets CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/assets/*")
foreach(asset IN LISTS _forge_assets)
    get_filename_component(name "${asset}" NAME)
    configure_file("${asset}" "${CMAKE_BINARY_DIR}/bin/assets/forge/${name}" COPYONLY)
endforeach()
if(BUILD_TESTING AND WIN32)
    set(_forge_lessons 10_basic_lighting 11_compute_shaders 12_shader_grid 13_instanced_rendering 14_environment_mapping)
    foreach(driver vulkan direct3d12)
        if(driver STREQUAL "direct3d12" AND NOT DASSDL3_WITH_SHADERCROSS)
            continue()
        endif()
        set(runner dasSDL3_runner)
        if(driver STREQUAL "direct3d12")
            set(runner dasSDL3_libraries_runner)
        endif()
        foreach(lesson IN LISTS _forge_lessons)
            add_test(NAME forge_${lesson}_${driver} COMMAND ${runner}
                "${CMAKE_SOURCE_DIR}/examples/gpu_port_forge/example_${lesson}/main.das" --smoke-test)
            set_tests_properties(forge_${lesson}_${driver} PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE
                ENVIRONMENT "SDL_GPU_DRIVER=${driver};SDL_ASSERT=abort"
                FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;D3D12 ERROR;D3D12 CORRUPTION")
        endforeach()
        if(Python3_EXECUTABLE)
            add_test(NAME forge_pixels_${driver} COMMAND "${Python3_EXECUTABLE}"
                "${CMAKE_SOURCE_DIR}/tests/test_forge_examples.py" --runner $<TARGET_FILE:${runner}> --driver ${driver})
            set_tests_properties(forge_pixels_${driver} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE)
        endif()
    endforeach()
    if(Python3_EXECUTABLE)
        add_test(NAME forge_shader_compiler COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_SOURCE_DIR}/tests/test_forge_shaders.py" --runner $<TARGET_FILE:dasSDL3_runner> ${_dsl_validator})
        set_tests_properties(forge_shader_compiler PROPERTIES TIMEOUT 120)
    endif()
    if(DASSDL3_TEST_VULKAN_LAYERS_DISABLE)
        get_property(_forge_tests DIRECTORY PROPERTY TESTS)
        foreach(test IN LISTS _forge_tests)
            if(test MATCHES "^forge_")
                set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "VK_LOADER_LAYERS_DISABLE=${DASSDL3_TEST_VULKAN_LAYERS_DISABLE}")
            endif()
        endforeach()
    endif()
endif()
