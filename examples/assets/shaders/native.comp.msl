#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RWStructuredBuffer_uint
{
    uint _m0[1];
};

struct type_Params
{
    uint4 values;
};

kernel void main0(constant type_Params& Params [[buffer(0)]], device type_RWStructuredBuffer_uint& output_data [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    output_data._m0[gl_GlobalInvocationID.x] = Params.values.x + (3u * gl_GlobalInvocationID.x);
}
