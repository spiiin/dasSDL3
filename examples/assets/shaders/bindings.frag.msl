#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Tint
{
    float4 tint;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_Tint& Tint [[buffer(0)]], texture2d<float> image [[texture(0)]], sampler imageSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = (image.sample(imageSmplr, in.in_var_TEXCOORD0) * in.in_var_TEXCOORD1) * Tint.tint;
    return out;
}
