#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Transform
{
    float4 rowX;
    float4 rowY;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_Transform& Transform [[buffer(0)]], texture2d<float> vertex_image [[texture(0)]], sampler vertex_imageSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 _35 = float4(in.in_var_TEXCOORD0, 0.0, 1.0);
    out.gl_Position = float4(dot(Transform.rowX, _35), dot(Transform.rowY, _35), 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = vertex_image.sample(vertex_imageSmplr, float2(0.25), level(0.0));
    return out;
}
