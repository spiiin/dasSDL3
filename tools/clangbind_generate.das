options gen2
options no_unused_block_arguments = false
require cbind/cbind_boost
require daslib/fio
require strings

class SdlProbeGen : CppGenBind {
    override func_to_stdout = false
    def SdlProbeGen(inc, sdk, output : string) {
        bind_root = output
        bind_module = "dasSDL3Probe"
        bind_das_module = "sdl3_probe"
        let args <- array<string>("-xc-header", "-std=c11",
            "--target=x86_64-pc-windows-msvc", "-Wno-pragma-pack",
            "-I{inc}", "-resource-dir={sdk}/lib/clang/22")
        super("SDL3/SDL.h", "{inc}/", args)
        enum_prefix["SDL_GPUVertexInputRate"] = "SDL_GPU_VERTEXINPUTRATE"
        enum_prefix["SDL_GPUVertexElementFormat"] = "SDL_GPU_VERTEXELEMENTFORMAT"
        for (name in fixed_array("SDL_FRect", "SDL_Rect", "SDL_Point", "SDL_FPoint", "SDL_GPUViewport", "SDL_GUID", "SDL_GPUVertexBufferDescription", "SDL_GPUVertexAttribute", "SDL_GPUVertexInputState")) {
            trivial_ctor_type_names[name] = true
            copyable_type_names[name] = true
        }
        openAllFiles()
    }
    def override openFile(path : string) {
        let file = fopen(path, "wb")
        if (file == null) { panic("Cannot write generated file: {path}") }
        fwrite(file, "// Generated by tools/clangbind_generate.das. Do not edit.\n\n")
        return file
    }
    def override skip_file(fname : string) : bool {
        return !(ends_with(fname, "SDL_rect.h") || ends_with(fname, "SDL_pixels.h") || ends_with(fname, "SDL_gpu.h") || ends_with(fname, "SDL_guid.h"))
    }
    def override skip_struct(name : string) : bool {
        let unqualified = starts_with(name, "const ") ? slice(name, 6) : name
        let n = starts_with(unqualified, "struct ") ? slice(unqualified, 7) : unqualified
        return !(n == "SDL_FRect" || n == "SDL_Rect" || n == "SDL_Point" || n == "SDL_FPoint" || n == "SDL_GPUViewport" || n == "SDL_GUID" || n == "SDL_GPUVertexBufferDescription" || n == "SDL_GPUVertexAttribute" || n == "SDL_GPUVertexInputState")
    }
    def override skip_alias(var c : CXCursor) : bool { return true }
    def override functionPtrSpelling(var c : CXCursor; isMethod : bool) : string {
        // C11 AST spells bool as _Bool; emitted code is compiled as C++.
        return replace(CppGenBind`functionPtrSpelling(self, c, isMethod), "_Bool", "bool")
    }
    def override skip_enum(ns_en, en : string) : bool {
        return en != "SDL_PixelFormat" && en != "SDL_GPUVertexInputRate" && en != "SDL_GPUVertexElementFormat"
    }
    def override skip_function(var c : CXCursor) : bool {
        let name = string(clang_getCursorSpelling(c))
        if (name != "SDL_GetRectIntersectionFloat" && name != "SDL_GetPixelFormatName" && name != "SDL_PointInRect") { return true }
        return AnyGenBind`skip_function(self, c)
    }
}

[export]
def main : int {
    let args <- get_command_line_arguments()
    if (length(args) < 4) { return 2 }
    var gen = new SdlProbeGen(args[length(args) - 3], args[length(args) - 2], args[length(args) - 1])
    gen->generate()
    gen->closeAllFiles()
    unsafe { delete gen }
    return 0
}
